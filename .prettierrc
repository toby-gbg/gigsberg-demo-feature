{
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always",
    "importOrder": [
        "^(react/(.*)$)|^(react$)",
        "^(next/(.*)$)|^(next$)",
        "<BUILTIN_MODULES>",
        "<THIRD_PARTY_MODULES>",
        "",
        "^@/assets/(.*)$",
        "^types$",
        "^@/interfaces/(.*)$",
        "^@/types/(.*)$",
        "^@/config/(.*)$",
        "^@/stores(/(.*))?$",
        "^@/lib/(.*)$",
        "^@/utils/(.*)$",
        "^@/services/(.*)$",
        "^@/swr/(.*)$",
        "^@/messages/(.*)$",
        "^@/constants/(.*)$",
        "",
        "^@/providers/(.*)$",
        "^@/hooks/(.*)$",
        "",
        "^@/styles/(.*)$",
        "^@/components/(.*)$",
        "",
        "^[./]"
    ],
    "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
    "plugins": ["prettier-plugin-tailwindcss", "@ianvs/prettier-plugin-sort-imports"]
}
